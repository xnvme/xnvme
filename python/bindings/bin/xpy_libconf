#!/usr/bin/env python3
import itertools
import sys

import xnvme


def main():
    """Print xNVMe library information, the NULL-terminated strings of libconf"""

    entries = xnvme.xnvme_libconf_get().contents.entries

    print("xnvme_libconf:")
    print("  entries:")
    for i in itertools.count():
        if not entries[i]:
            break
        print(f"  - '{entries[i].decode()}'")

    return 0


if __name__ == "__main__":
    sys.exit(main())

# Configuration for one HOMI server, read by xnvme-homi@.service.
#
# Install as homi-<homi_id>.conf next to this file, so that homi-1.conf
# configures the instance started by `systemctl start xnvme-homi@1`. That is
# /etc/xnvme/ for a default build, and the sysconfdir of the build otherwise;
# the unit reads from wherever this file was installed.

# Controllers to hold, space separated. These must already be bound to a
# userspace driver; the unit refuses to start rather than binding them itself.
HOMI_DEVICES=0000:03:00.0 0000:04:00.0

# Anything else to pass to `homi start`. The heap defaults are deliberately
# small, since a server holds controllers rather than doing I/O, so the usual
# reason to set anything here is --be.
#
#   --be upcie          host memory (default where the driver allows it)
#   --be upcie-cuda     also brings up a CUDA context and a small device heap
#   --be upcie-hip      likewise for ROCm
HOMI_OPTS=--be upcie

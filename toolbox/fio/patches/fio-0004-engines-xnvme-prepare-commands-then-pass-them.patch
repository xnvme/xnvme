+/* The one-call command functions gave way to a prep of the command then a pass of it */
+#if defined(XNVME_CMD_PREP_ZNS) && defined(XNVME_CMD_PREP_IO)
+static int fio_xnvme_zone_reset(struct xnvme_cmd_ctx *ctx, uint32_t nsid, uint64_t zslba)
+{
+	struct xnvme_cmd_prep_zns_zone_management_send_args args = {
+		.args_nbytes = sizeof(args),
+		.nsid = nsid,
+		.slba = zslba,
+		.zsa = XNVME_SPEC_ZND_CMD_MGMT_SEND_RESET,
+	};
+	int err = xnvme_cmd_prep_zns_zone_management_send(&ctx->cmd, &args);
+
+	return err ? err : xnvme_cmd_pass(ctx, NULL, 0, NULL, 0);
+}
+
+static int fio_xnvme_ruhs(struct xnvme_cmd_ctx *ctx, uint32_t nsid, void *buf, uint32_t nbytes)
+{
+	struct xnvme_cmd_prep_io_io_management_receive_args args = {
+		.args_nbytes = sizeof(args),
+		.nsid = nsid,
+		.mo = XNVME_SPEC_IO_MGMT_RECV_RUHS,
+		.numd = nbytes / sizeof(uint32_t) - 1,
+	};
+	int err = xnvme_cmd_prep_io_io_management_receive(&ctx->cmd, &args);
+
+	return err ? err : xnvme_cmd_pass(ctx, buf, nbytes, NULL, 0);
+}
+#else
+#define fio_xnvme_zone_reset(ctx, nsid, zslba) \
+	xnvme_znd_mgmt_send(ctx, nsid, zslba, false, XNVME_SPEC_ZND_CMD_MGMT_SEND_RESET, 0x0, NULL)
+#define fio_xnvme_ruhs(ctx, nsid, buf, nbytes) \
+	xnvme_nvm_mgmt_recv(ctx, nsid, XNVME_SPEC_IO_MGMT_RECV_RUHS, 0, buf, nbytes)
+#endif

+
+/* The common command fields are named as the spec names them where xNVMe defines OPC's masks */
+#ifdef XNVME_SPEC_CMD_COMMON_OPC_FN
+#define FIO_XNVME_SET_OPC(cmd, val) ((cmd)->common.opc = (val))
+#define FIO_XNVME_SET_CDW3(cmd, val) ((cmd)->common.cdw3 = (val))
+/* The RUH status descriptor has no mask of its own; it was renamed with the above */
+#define FIO_XNVME_RUHS_PID(desc) ((desc)->pid)
+#else
+#define FIO_XNVME_SET_OPC(cmd, val) ((cmd)->common.opcode = (val))
+#define FIO_XNVME_SET_CDW3(cmd, val) ((cmd)->common.cdw03 = (val))
+#define FIO_XNVME_RUHS_PID(desc) ((desc)->pi)
+#endif
+
+/* Dword 12 of an NVM command is an integer behind masks where xNVMe defines them */
+#ifdef XNVME_SPEC_CMD_NVM_CDW12_NLB
+#define FIO_XNVME_NVM_CDW12_SET(cmd, mask, val) \
+	((cmd)->nvm.cdw12 = (uint32_t)xnvme_bits_set((cmd)->nvm.cdw12, (mask), (val)))
+#define FIO_XNVME_SET_NLB(cmd, val) FIO_XNVME_NVM_CDW12_SET(cmd, XNVME_SPEC_CMD_NVM_CDW12_NLB, val)
+#define FIO_XNVME_SET_DTYPE(cmd, val) \
+	FIO_XNVME_NVM_CDW12_SET(cmd, XNVME_SPEC_CMD_NVM_CDW12_DTYPE, val)
+#define FIO_XNVME_SET_PRINFO(cmd, val) \
+	FIO_XNVME_NVM_CDW12_SET(cmd, XNVME_SPEC_CMD_NVM_CDW12_PRINFO, val)
+#else
+#define FIO_XNVME_SET_NLB(cmd, val) ((cmd)->nvm.nlb = (val))
+#define FIO_XNVME_SET_DTYPE(cmd, val) ((cmd)->nvm.dtype = (val))
+#define FIO_XNVME_SET_PRINFO(cmd, val) ((cmd)->nvm.prinfo = (val))
+#endif
+
+/* So is dword 13 */
+#ifdef XNVME_SPEC_CMD_NVM_CDW13_DSPEC
+#define FIO_XNVME_SET_DSPEC(cmd, val) \
+	((cmd)->nvm.cdw13 = \
+		 (uint32_t)xnvme_bits_set((cmd)->nvm.cdw13, XNVME_SPEC_CMD_NVM_CDW13_DSPEC, (val)))
+#else
+#define FIO_XNVME_SET_DSPEC(cmd, val) ((cmd)->nvm.cdw13.dspec = (val))
+#endif
+
+/* Dword 14 carries the reference tag as the lower logical block tags where xNVMe names it so */
+#ifdef XNVME_SPEC_CMD_NVM_CDW02_03_LBTU
+#define FIO_XNVME_SET_ILBRT(cmd, val) ((cmd)->nvm.lbtl = (val))
+#else
+#define FIO_XNVME_SET_ILBRT(cmd, val) ((cmd)->nvm.ilbrt = (val))
+#endif
+
+/* The zone type and state are bits of a byte behind masks where xNVMe defines them */
+#ifdef XNVME_SPEC_ZND_DESCR_ZTATTR_ZT
+#define FIO_XNVME_ZND_ZT(descr) xnvme_bits_get((descr)->ztattr, XNVME_SPEC_ZND_DESCR_ZTATTR_ZT)
+#define FIO_XNVME_ZND_ZS(descr) xnvme_bits_get((descr)->zsattr, XNVME_SPEC_ZND_DESCR_ZSATTR_ZS)
+#else
+#define FIO_XNVME_ZND_ZT(descr) ((descr)->zt)
+#define FIO_XNVME_ZND_ZS(descr) ((descr)->zs)
+#endif

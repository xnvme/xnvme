_xnvme-test-buf_completions()
{
    local cur=${COMP_WORDS[COMP_CWORD]}
    local sub=""
    local opts=""

    COMPREPLY=()

    # Complete sub-commands
    if [[ $COMP_CWORD < 2 ]]; then
        COMPREPLY+=( $( compgen -W 'buf_alloc_free buf_alloc_free_threads buf_vtophys buf_virt_alloc_free --help' -- $cur ) )
        return 0
    fi

    # Complete sub-command arguments

    sub=${COMP_WORDS[1]}

    if [[ "$sub" != "enum" ]]; then
        opts+="/dev/nvme* "
    fi

    case "$sub" in
    
    "buf_alloc_free")
        opts+="--count --subnqn --hostnqn --be --shm_id --homi-id --dev-nsid --admin --mem --direct --help"
        ;;

    "buf_alloc_free_threads")
        opts+="--count --subnqn --hostnqn --be --shm_id --homi-id --dev-nsid --admin --mem --direct --help"
        ;;

    "buf_vtophys")
        opts+="--subnqn --hostnqn --be --shm_id --homi-id --dev-nsid --admin --mem --direct --help"
        ;;

    "buf_virt_alloc_free")
        opts+="--count --subnqn --hostnqn --be --shm_id --homi-id --dev-nsid --admin --mem --direct --help"
        ;;

    esac

    COMPREPLY+=( $( compgen -W "$opts" -- $cur ) )

    return 0
}

#
complete -o nosort -F _xnvme-test-buf_completions xnvme-test-buf


# Upgrade existing packages to avoid library version mismatches
if ( "`printenv XNVME_PKGS_NO_UPGRADE`" != "1" ) then
  pkg upgrade -qy
endif

# Install packages via the system package-manager (pkg)
pkg install -qy \
{%- for dep in deps %}
 {{ dep }}{% if not loop.last %} \{% endif %}
{%- endfor %}

xnvme_dev:
  xnvme_ident:
    uri: '/dev/nvme0n1'
    dtype: 0x2
    nsid: 0x1
    csi: 0x0
    kernel_driver: ''
    iommu_group: ''
    subnqn: 'nqn.2019-08.org.qemu:beef0000'
  xnvme_be:
    dev: {id: 'linux'}
    admin: {id: 'nvme'}
    sync: {id: 'nvme'}
    async: {id: 'emu'}
    mem: {id: 'posix'}
    attr: {name: 'emu', descr: 'Emulated async with NVMe ioctl', caps: 0x3}
  xnvme_opts:
    be: 'emu'
    mem: 'posix'
    dev: 'linux'
    admin: 'nvme'
    sync: 'nvme'
    async: 'emu'
  xnvme_geo:
    type: XNVME_GEO_CONVENTIONAL
    npugrp: 1
    npunit: 1
    nzone: 1
    nsect: 2097152
    nbytes: 4096
    nbytes_oob: 0
    tbytes: 8589934592
    mdts_nbytes: 520192
    lba_nbytes: 4096
    lba_extended: 0
    ssw: 12
    pi_type: 0
    pi_loc: 0
    pi_format: 0

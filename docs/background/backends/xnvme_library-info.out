# xNVMe Library Information
ver: {major: 0, minor: 7, patch: 5, vcs: 'v0.7.5'}
xnvme_libconf:
  entries:
  - 'spdk;NOSYS'
  - 'conf: XNVME_BE_SHIM_ENABLED'
  - 'conf: XNVME_BE_EMU_ENABLED'
  - 'conf: XNVME_BE_NIL_ENABLED'
  - 'conf: XNVME_BE_POSIX_ENABLED'
  - 'conf: XNVME_BE_THRPOOL_ENABLED'
  - 'conf: XNVME_BE_RAMDISK_ENABLED'
  - 'conf: XNVME_PLATFORM_LINUX_ENABLED'
  - 'conf: XNVME_BE_LINUX_BLOCK_ENABLED'
  - 'conf: XNVME_BE_LINUX_BLOCK_ZONED_ENABLED'
  - 'conf: XNVME_BE_LIBURING_ENABLED'
  - 'conf: XNVME_BE_UPCIE_ENABLED'
  - '3p: NVME_IOCTL_IO64_CMD'
  - '3p: NVME_IOCTL_IO64_CMD_VEC'
  - '3p: NVME_IOCTL_ADMIN64_CMD'
  - '3p: linux;LINUX_VERSION_CODE-UAPI/458752-7.0.0'

xnvme_platform:
  name: 'linux'
  backends:
  - {name: 'upcie', async: 'upcie', sync: 'upcie', admin: 'upcie', descr: 'uPCIe userspace NVMe driver', caps: 0x120}
  - {name: 'emu', async: 'emu', sync: 'nvme', admin: 'nvme', descr: 'Emulated async with NVMe ioctl', caps: 0x3}
  - {name: 'emu_bdev', async: 'emu', sync: 'block', admin: 'block', descr: 'Emulated async with block layer', caps: 0x6}
  - {name: 'io_uring_cmd', async: 'io_uring_cmd', sync: 'nvme', admin: 'nvme', descr: 'io_uring passthru with NVMe ioctl', caps: 0x3}
  - {name: 'io_uring', async: 'io_uring', sync: 'nvme', admin: 'nvme', descr: 'io_uring with NVMe ioctl', caps: 0x3}
  - {name: 'io_uring_bdev', async: 'io_uring', sync: 'block', admin: 'block', descr: 'io_uring with block layer', caps: 0x6}
  - {name: 'posix', async: 'posix', sync: 'nvme', admin: 'nvme', descr: 'POSIX aio with NVMe ioctl', caps: 0x3}
  - {name: 'thrpool', async: 'thrpool', sync: 'nvme', admin: 'nvme', descr: 'Thread pool with NVMe ioctl', caps: 0x3}
  - {name: 'thrpool_bdev', async: 'thrpool', sync: 'block', admin: 'block', descr: 'Thread pool with block layer', caps: 0x6}
  - {name: 'nil', async: 'nil', sync: 'nvme', admin: 'nvme', descr: 'Nil async with NVMe ioctl', caps: 0x3}
  - {name: 'emu_file', async: 'emu', sync: 'psync', admin: 'file_as_ns', descr: 'Emulated async with file I/O', caps: 0x8}
  - {name: 'thrpool_file', async: 'thrpool', sync: 'psync', admin: 'file_as_ns', descr: 'Thread pool with file I/O', caps: 0x8}
  - {name: 'io_uring_file', async: 'io_uring', sync: 'psync', admin: 'file_as_ns', descr: 'io_uring with file I/O', caps: 0x8}
  - {name: 'ramdisk_emu', async: 'emu', sync: 'ramdisk', admin: 'ramdisk', descr: 'Ramdisk with emulated async', caps: 0x10}
  - {name: 'ramdisk_thrpool', async: 'thrpool', sync: 'ramdisk', admin: 'ramdisk', descr: 'Ramdisk with thread pool', caps: 0x10}
  - {name: 'ramdisk', async: 'nil', sync: 'ramdisk', admin: 'ramdisk', descr: 'Ramdisk with nil async', caps: 0x10}

